---
export interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;

// /page/1 は / へ正規化
const normalizedPrevUrl = prevUrl === '/page/1' ? '/' : prevUrl;
---

{lastPage > 1 && (
  <nav class="pagination" aria-label="ページネーション">
    {normalizedPrevUrl ? (
      <a href={normalizedPrevUrl} class="pagination-link pagination-prev" rel="prev">
        &larr; 前のページ
      </a>
    ) : (
      <span class="pagination-link pagination-disabled" aria-disabled="true">
        &larr; 前のページ
      </span>
    )}

    <span class="pagination-info" aria-current="page">
      {currentPage} / {lastPage} ページ
    </span>

    {nextUrl ? (
      <a href={nextUrl} class="pagination-link pagination-next" rel="next">
        次のページ &rarr;
      </a>
    ) : (
      <span class="pagination-link pagination-disabled" aria-disabled="true">
        次のページ &rarr;
      </span>
    )}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text);
    border-radius: 4px;
    text-decoration: none;
  }

  a.pagination-link:hover {
    background: var(--color-surface);
    color: var(--color-link);
    text-decoration: underline;
  }

  a.pagination-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .pagination-disabled {
    color: var(--color-text-muted);
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pagination-info {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }
</style>
