---
import Base from './Base.astro';

const { title, description, appHome, privacy } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <article class="app-info">
    <nav aria-label="アプリの案内">
      <a href={appHome}>アプリ紹介</a>
      <a href={privacy}>プライバシーポリシー</a>
    </nav>
    <header><h1>{title}</h1></header>
    <div class="content"><slot /></div>
  </article>
</Base>

<style>
  .app-info { max-width: 48rem; margin-inline: auto; overflow-wrap: anywhere; }
  nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 2rem; }
  nav a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  h1 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.5; margin-bottom: 1.5rem; }
  .content :global(h2) { font-size: 1.25rem; margin-block: 2rem 0.75rem; }
  .content :global(p), .content :global(ul) { margin-bottom: 1rem; }
  .content :global(ul) { padding-inline-start: 1.5rem; }
  .content :global(li + li) { margin-top: 0.5rem; }
  .app-info :global(a) { color: var(--color-link); text-decoration: underline; text-underline-offset: 0.2em; }
  .app-info :global(a:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
</style>
