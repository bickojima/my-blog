---
import { getCollection } from 'astro:content';
import ArchiveNav from '../components/ArchiveNav.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const DEFAULT_DESCRIPTION = 'tbiの個人ブログ。日々のできごとを記録しています。';

const { title, description, ogImage, ogType = 'website' } = Astro.props;
const isStaging = import.meta.env.CF_PAGES_BRANCH === 'staging';
const siteTitle = isStaging ? '[STAGING] tbiのブログ' : 'tbiのブログ';
const navPages = (await getCollection('pages'))
  .filter(p => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const metaDescription = description ?? DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={siteTitle} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <style is:global>
    :root {
      --color-bg: #fff;
      --color-text: #333;
      --color-text-muted: #767676;
      --color-text-secondary: #595959;
      --color-border: #eee;
      --color-link: #1a73e8;
      --color-focus: #1a73e8;
      --color-tag-bg: #f0f0f0;
      --color-tag-text: #555;
      --color-surface: #f5f5f5;
      --color-invert-bg: #333;
      --color-invert-text: #fff;
      --color-invert-muted: #ccc;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --color-bg: #121212;
        --color-text: #e6e6e6;
        --color-text-muted: #9a9a9a;
        --color-text-secondary: #b3b3b3;
        --color-border: #333;
        --color-link: #7db8f5;
        --color-focus: #7db8f5;
        --color-tag-bg: #2a2a2a;
        --color-tag-text: #ccc;
        --color-surface: #1e1e1e;
        --color-invert-bg: #e6e6e6;
        --color-invert-text: #121212;
        --color-invert-muted: #555;
      }
    }
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      background-color: var(--color-bg);
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
      line-height: 1.8;
      color: var(--color-text);
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    img {
      max-width: 100%;
      height: auto;
      image-orientation: from-image;
    }
  </style>
  <style>
    header {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--color-border);
    }
    header nav {
      max-width: 700px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .site-title {
      font-size: 1.1rem;
      font-weight: bold;
      text-wrap: balance;
    }
    .nav-links {
      display: flex;
      gap: 1rem;
    }
    .nav-links > a {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
    }
    .nav-links > a:hover {
      color: var(--color-text);
    }
    .nav-links a:focus-visible,
    .nav-dropdown-toggle:focus-visible,
    .admin-link:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
      border-radius: 3px;
    }
    .nav-dropdown {
      position: relative;
    }
    .nav-dropdown-link {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
    }
    .nav-dropdown-link:hover {
      color: var(--color-text);
    }
    .nav-dropdown-toggle {
      background: none;
      border: none;
      font-family: inherit;
      font-size: 1.1rem;
      color: var(--color-text-secondary);
      cursor: pointer;
      padding: 0.1rem 0.3rem;
      margin-left: 0.1rem;
      line-height: 1;
      vertical-align: middle;
    }
    .nav-dropdown-toggle:hover {
      color: var(--color-text);
    }
    .nav-dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      padding-top: 0.25rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 4px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      min-width: 120px;
      z-index: 100;
    }
    .nav-dropdown.is-open .nav-dropdown-menu {
      display: block;
    }
    .nav-dropdown-menu a {
      display: block;
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
      color: var(--color-tag-text);
      white-space: nowrap;
    }
    .nav-dropdown-menu a:hover {
      background: var(--color-surface);
      color: var(--color-text);
    }
    .nav-dropdown-menu a:focus-visible {
      background: var(--color-surface);
      color: var(--color-text);
    }
    main {
      max-width: 700px;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }
    footer {
      text-align: center;
      padding: 2rem 1.5rem;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      margin-top: 3rem;
    }
    .admin-link {
      display: inline-block;
      margin-top: 0.5rem;
      font-size: 0.65rem;
      color: var(--color-text-muted);
    }
    .admin-link:hover {
      color: var(--color-text);
    }
    @media (max-width: 899px), (hover: none), (pointer: coarse) {
      .nav-links > a,
      .nav-dropdown-link,
      .nav-dropdown-toggle,
      .nav-dropdown-menu a,
      .admin-link {
        min-height: 44px;
      }
      .nav-links > a,
      .nav-dropdown-link,
      .nav-dropdown-menu a,
      .admin-link {
        display: inline-flex;
        align-items: center;
      }
      .nav-dropdown-toggle,
      .admin-link {
        min-width: 44px;
        justify-content: center;
      }
      .nav-dropdown-menu a {
        display: flex;
      }
    }
  </style>
</head>
<body>
  <header>
    <nav aria-label="メイン">
      <a href="/" class="site-title">{siteTitle}</a>
      <div class="nav-links">
        {navPages.length === 1 ? (
          <a href={`/${navPages[0].slug}`}>{navPages[0].data.title}</a>
        ) : navPages.length > 1 ? (
          <div class="nav-dropdown">
            <a href={`/${navPages[0].slug}`} class="nav-dropdown-link">{navPages[0].data.title}</a><button class="nav-dropdown-toggle" type="button" aria-label="ページメニュー" aria-expanded="false" aria-controls="page-menu">▾</button>
            <div class="nav-dropdown-menu" id="page-menu">
              {navPages.map(page => (
                <a href={`/${page.slug}`}>{page.data.title}</a>
              ))}
            </div>
          </div>
        ) : null}
      </div>
    </nav>
  </header>
  <main>
    <slot />
    <ArchiveNav />
  </main>
  <footer>
    <p>&copy; {new Date().getFullYear()} {siteTitle}</p>
    <a href="/admin/" class="admin-link">管理</a>
  </footer>
  <script>
    const dropdown = document.querySelector('.nav-dropdown');
    if (dropdown) {
      const toggle = dropdown.querySelector('.nav-dropdown-toggle');
      const setOpen = (open: boolean) => {
        dropdown.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      };
      let closeTimer: ReturnType<typeof setTimeout> | null = null;
      let openedByHover = false;
      // PC（ホバー可能デバイス）のみ: mouseenter/mouseleaveで開閉
      // モバイル（タッチデバイス）ではhoverイベントがclickより先に発火し、
      // ドロップダウンが一瞬開いてすぐ閉じるバグを防止するため除外
      const canHover = window.matchMedia('(hover: hover)').matches;
      if (canHover) {
        dropdown.addEventListener('mouseenter', () => {
          if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
          openedByHover = true;
          setOpen(true);
        });
        dropdown.addEventListener('mouseleave', () => {
          closeTimer = setTimeout(() => {
            setOpen(false);
            openedByHover = false;
            closeTimer = null;
          }, 300);
        });
      }
      // ▾ボタン: クリック/タップでトグル
      toggle?.addEventListener('click', () => {
        if (dropdown.classList.contains('is-open') && openedByHover) {
          openedByHover = false;
          setOpen(true);
          return;
        }
        openedByHover = false;
        setOpen(!dropdown.classList.contains('is-open'));
      });
      // 外側クリックで閉じる
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Node) || !dropdown.contains(e.target)) {
          setOpen(false);
        }
      });
      // Escapeで閉じ、キーボードフォーカスがメニュー外へ移動した場合も閉じる
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !dropdown.classList.contains('is-open')) return;
        setOpen(false);
        openedByHover = false;
        if (dropdown.contains(document.activeElement)) toggle?.focus();
      });
      dropdown.addEventListener('focusout', (e) => {
        if (e.relatedTarget instanceof Node && dropdown.contains(e.relatedTarget)) return;
        setOpen(false);
        openedByHover = false;
      });
    }
  </script>
</body>
</html>
