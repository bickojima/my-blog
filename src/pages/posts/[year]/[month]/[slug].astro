---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getPostUrl, getPostUrlParts } from '../../../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const posts = allPosts
    .filter(post => !post.data.draft)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return posts.map((post, index) => {
    const { year, month, slug } = getPostUrlParts(post);
    return {
      params: { year, month, slug },
      props: {
        post,
        prevPost: posts[index + 1], // 1つ古い記事（date降順配列なので次の要素）
        nextPost: posts[index - 1], // 1つ新しい記事
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
---

<Base title={post.data.title} description={post.data.summary} ogImage={post.data.thumbnail} ogType="article">
  <article>
    <header class="post-header">
      <time datetime={post.data.date}>{post.data.date}</time>
      <h1>{post.data.title}</h1>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag: string) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    <nav class="post-adjacent-nav" aria-label="前後の記事">
      {prevPost && (
        <a href={getPostUrl(prevPost)} class="adjacent-link adjacent-prev" rel="prev">
          <span class="adjacent-label">&larr; 前の記事</span>
          <span class="adjacent-title">{prevPost.data.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={getPostUrl(nextPost)} class="adjacent-link adjacent-next" rel="next">
          <span class="adjacent-label">次の記事 &rarr;</span>
          <span class="adjacent-title">{nextPost.data.title}</span>
        </a>
      )}
    </nav>

    <footer class="post-footer">
      <a href="/">&larr; 記事一覧に戻る</a>
    </footer>
  </article>

  <style>
    .post-header {
      margin-bottom: 2rem;
    }
    .post-header time {
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }
    .post-header h1 {
      font-size: 1.6rem;
      margin-top: 0.25rem;
      line-height: 1.4;
      text-wrap: balance;
    }
    .post-content {
      line-height: 1.9;
      overflow-wrap: anywhere;
    }
    .post-content :global(h2) {
      font-size: 1.3rem;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      text-wrap: balance;
    }
    .post-content :global(h3) {
      font-size: 1.1rem;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      text-wrap: balance;
    }
    .post-content :global(p) {
      margin-bottom: 1rem;
      text-wrap: pretty;
    }
    .post-content :global(a) {
      color: var(--color-link);
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
    .post-content :global(a:focus-visible) {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
      border-radius: 3px;
    }
    .post-content :global(figure) {
      margin: 1.5rem 0;
    }
    .post-content :global(figure img) {
      border-radius: 4px;
    }
    .post-content :global(figcaption) {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
      text-align: center;
      margin-top: 0.5rem;
    }
    .post-content :global(img) {
      border-radius: 4px;
      margin: 1rem 0;
    }
    .post-content :global(code) {
      background: var(--color-surface);
      padding: 0.15rem 0.3rem;
      border-radius: 3px;
      font-size: 0.9em;
    }
    .post-content :global(pre) {
      background: var(--color-surface);
      padding: 1rem;
      border-radius: 4px;
      overflow-x: auto;
      margin: 1rem 0;
    }
    .post-content :global(pre:focus-visible) {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
    }
    .post-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }
    .tag {
      font-size: 0.75rem;
      background: var(--color-tag-bg);
      color: var(--color-tag-text);
      padding: 0.1rem 0.5rem;
      border-radius: 3px;
    }
    .tag:hover {
      background: var(--color-invert-bg);
      color: var(--color-invert-text);
    }
    .tag:focus-visible,
    .post-footer a:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
      border-radius: 3px;
    }
    .post-adjacent-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }
    .adjacent-link {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-height: 44px;
      padding: 0.5rem 0;
    }
    .adjacent-next {
      grid-column: 2;
      text-align: right;
    }
    .adjacent-label {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }
    .adjacent-title {
      font-size: 0.9rem;
      color: var(--color-text);
      text-wrap: pretty;
    }
    .adjacent-link:hover .adjacent-title {
      text-decoration: underline;
    }
    .adjacent-link:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
      border-radius: 3px;
    }
    .post-footer {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
    }
    .post-footer a {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }
    .post-footer a:hover {
      color: var(--color-text);
    }
  </style>
</Base>
